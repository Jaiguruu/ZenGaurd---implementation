# =============================================================================
# File: .env.example
# Project: ZenGuard Zero Trust SIEM
# Description: Environment variable template. Copy to `.env` and fill in real
#              values. NEVER commit a populated .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with real credentials
#   docker compose --env-file .env up -d
# =============================================================================

# --- Elasticsearch ---
ELASTIC_PASSWORD=ZenGuard@2024!

# --- Kibana encryption key (must be >= 32 characters) ---
KIBANA_ENC_KEY=a7f3d9e2c6b1a4f8d2e7c3b6a1f4d9e2c8b5a2f7

# --- siem_listener.py runtime config ---
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=ZenGuard@2024!
ES_INDEX=zenguard-*
POLL_INTERVAL_S=5
LOOK_BACK_S=5
ALERT_EVENT_TYPES=failed_logins,snort_alerts,privilege_escalation,wazuh_alert,port_scan
MAX_EVENTS_PER_POLL=200
RETRY_MAX=10
RETRY_BASE_DELAY_S=2.0
LOG_LEVEL=INFO
LOG_FILE=/var/log/zenguard/siem_listener.log
